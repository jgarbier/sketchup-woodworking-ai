{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "units": {
          "type": "string",
          "const": "inches"
        }
      },
      "required": [
        "id",
        "name",
        "units"
      ],
      "additionalProperties": false
    },
    "overall": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "depth",
        "height"
      ],
      "additionalProperties": false
    },
    "materials": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
          },
          "species": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "type": {
            "type": "string",
            "enum": [
              "hardwood",
              "softwood",
              "plywood",
              "sheet_good"
            ]
          }
        },
        "required": [
          "id",
          "species",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "parts": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "type": {
            "type": "string",
            "enum": [
              "board",
              "panel"
            ]
          },
          "material": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "dimensions": {
            "type": "object",
            "properties": {
              "length": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "thickness": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "length",
              "width",
              "thickness"
            ],
            "additionalProperties": false
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          },
          "rotation": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          },
          "additional_positions": {
            "maxItems": 99,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ],
              "additionalProperties": false
            }
          },
          "stock_type": {
            "type": "string",
            "enum": [
              "hardwood",
              "softwood",
              "plywood",
              "sheet_good"
            ]
          },
          "grain_direction": {
            "type": "string",
            "enum": [
              "length",
              "width",
              "none"
            ]
          },
          "notes": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "material",
          "quantity",
          "dimensions",
          "position",
          "rotation",
          "additional_positions",
          "stock_type",
          "grain_direction",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "relationships": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "part_id",
          "depends_on",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "door_assemblies": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
            }
          },
          "swing": {
            "type": "string",
            "enum": ["left", "right", "bi-fold", "sliding"]
          },
          "clearance_gap": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": ["id", "name", "parts", "swing"],
        "additionalProperties": false
      }
    },
    "drawer_assemblies": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
            }
          },
          "face_part_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
          },
          "slide_type": {
            "type": "string",
            "enum": ["side-mount", "undermount", "center-mount"]
          },
          "clearance_left":   { "type": "number", "exclusiveMinimum": 0 },
          "clearance_right":  { "type": "number", "exclusiveMinimum": 0 },
          "clearance_top":    { "type": "number", "exclusiveMinimum": 0 },
          "clearance_bottom": { "type": "number", "exclusiveMinimum": 0 },
          "extension": {
            "type": "string",
            "enum": ["full", "three-quarter"]
          }
        },
        "required": ["id", "name", "parts", "slide_type"],
        "additionalProperties": false
      }
    },
    "joints": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
          },
          "type": {
            "type": "string",
            "enum": ["mortise-tenon", "dado", "rabbet", "pocket-hole", "lap", "dovetail", "biscuit", "dowel"]
          },
          "part_a": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
          },
          "part_b": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
          },
          "depth": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "thickness": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "notes": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "required": ["id", "type", "part_a", "part_b"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "project",
    "overall",
    "materials",
    "parts",
    "relationships",
    "notes"
  ],
  "additionalProperties": false,
  "$comment": "Canonical inches. Semantic validation also requires unique IDs, valid material/relationship references, at most 500 instances, quantity minus one additional_positions, door_assembly part references pointing to declared parts, and joint part references pointing to declared parts."
}
